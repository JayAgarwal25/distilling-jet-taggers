+        # jetkd: gradient accumulation over grad_accum micro-batches, each weighted by
+        # its share of the batch, with one clipped optimizer step per batch.
+        # grad_accum=1 (the default) is the upstream code path.
+        n_batch = X.shape[0]
+        bounds = [n_batch * i // grad_accum for i in range(grad_accum + 1)]
+        for lo, hi in zip(bounds[:-1], bounds[1:]):
+            if hi == lo:
+                continue
+            if grad_accum > 1:
+                share = (hi - lo) / n_batch
+                logs_before = {key: val.clone() for key, val in logs.items()}
